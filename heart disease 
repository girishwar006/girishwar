    st.dataframe(y_train.value_counts().rename("count").to_frame(), use_container_width=True)
    st.write("Test class distribution:")
    st.dataframe(y_test.value_counts().rename("count").to_frame(), use_container_width=True)

# =========================================================
# TAB 2: MODEL COMPARISON
# =========================================================
with tab2:
    st.header("2. Model Comparison")

    st.markdown('<div class="section-card">', unsafe_allow_html=True)
    st.write("Compare commonly used classification models and review their test-set metrics.")
    st.markdown("</div>", unsafe_allow_html=True)

    if st.button("Run Model Comparison", use_container_width=True):
        models = build_models(random_state=int(random_state))

        results = []
        fitted = {}

        progress = st.progress(0)
        total_steps = len(models)

        for idx, (name, model) in enumerate(models.items()):
            model.fit(X_train, y_train)
            preds = model.predict(X_test)

            results.append({
                "Model": name,
                "Accuracy": accuracy_score(y_test, preds),
                "Precision": precision_score(y_test, preds, zero_division=0),
                "Recall": recall_score(y_test, preds, zero_division=0),
                "F1-Score": f1_score(y_test, preds, zero_division=0),
            })

            fitted[name] = model
            progress.progress((idx + 1) / total_steps)

        results_df = pd.DataFrame(results).set_index("Model")
        st.session_state["comparison_results"] = results_df
        st.session_state["fitted_models"] = fitted

        st.success("Model comparison completed successfully.")

    if st.session_state["comparison_results"] is not None:
        st.subheader("Comparative Performance Table")
        st.dataframe(st.session_state["comparison_results"].round(3), use_container_width=True)

        st.subheader("Bar Chart Comparison")
        st.bar_chart(st.session_state["comparison_results"])

    else:
        st.info("Click the button above to compare machine learning models.")

# =========================================================
# TAB 3: HYPERPARAMETER TUNING
# =========================================================
with tab3:
    st.header("3. Hyperparameter Tuning")

    st.markdown('<div class="section-card">', unsafe_allow_html=True)
    st.write("Tune a Random Forest model using GridSearchCV to improve performance on the training data.")
    st.markdown("</div>", unsafe_allow_html=True)

    with st.form("tuning_form"):
        n_estimators = st.multiselect("n_estimators", [50, 100, 200], default=[50, 100, 200])
        max_depth_values = st.multiselect("max_depth", [None, 5, 10, 20], default=[None, 5, 10])
        min_samples_split = st.multiselect("min_samples_split", [2, 5, 10], default=[2, 5])
        min_samples_leaf = st.multiselect("min_samples_leaf", [1, 2, 4], default=[1, 2])
        scoring = st.selectbox("Scoring metric", ["recall", "f1", "precision", "accuracy"], index=0)

        submitted = st.form_submit_button("Start Hyperparameter Tuning", use_container_width=True)

    if submitted:
        pipeline = Pipeline([
            ("imputer", SimpleImputer(strategy="median")),
            ("model", RandomForestClassifier(random_state=int(random_state)))
        ])

        param_grid = {
            "model__n_estimators": n_estimators,
            "model__max_depth": max_depth_values,
            "model__min_samples_split": min_samples_split,
            "model__min_samples_leaf": min_samples_leaf,
        }

        cv = StratifiedKFold(
            n_splits=cv_folds,
            shuffle=True,
            random_state=int(random_state)
        )

        grid_search = GridSearchCV(
            estimator=pipeline,
            param_grid=param_grid,
            scoring=scoring,
            cv=cv,
            n_jobs=-1,
            refit=True,
            verbose=0
        )

        with st.spinner("Running GridSearchCV..."):
            grid_search.fit(X_train, y_train)

        best_model = grid_search.best_estimator_
        best_params = grid_search.best_params_

        st.session_state["best_model"] = best_model
        st.session_state["best_params"] = best_params
        st.session_state["fitted_models"]["Tuned Random Forest"] = best_model

        st.success("Tuning complete.")
        st.subheader("Best Parameters")
        st.json(best_params)

        cv_results = pd.DataFrame(grid_search.cv_results_).sort_values("rank_test_" + scoring).head(10)
        display_cols = [
            "params",
            "mean_test_" + scoring,
            "std_test_" + scoring,
            "rank_test_" + scoring,
        ]
        st.subheader("Top Cross-Validation Results")
        st.dataframe(
            cv_results[display_cols].rename(
                columns={
                    f"mean_test_{scoring}": "mean_score",
                    f"std_test_{scoring}": "std_score",
                    f"rank_test_{scoring}": "rank"
                }
            ).round(3),
            use_container_width=True
        )

