        selected_model_name = st.selectbox(
            "Choose a trained model",
            list(available_models.keys()),
            key="selected_eval_model"
        )
        selected_model = available_models[selected_model_name]

        y_pred = selected_model.predict(X_test)

        accuracy = accuracy_score(y_test, y_pred)
        precision = precision_score(y_test, y_pred, zero_division=0)
        recall = recall_score(y_test, y_pred, zero_division=0)
        f1 = f1_score(y_test, y_pred, zero_division=0)

        st.subheader("Model Performance")
        metrics_cards(accuracy, precision, recall, f1)

        st.markdown("---")

        st.subheader("Confusion Matrix")
        cm = confusion_matrix(y_test, y_pred, labels=[0, 1])
        plot_confusion_matrix(cm)

        st.markdown("---")

        st.subheader("Classification Report")
        report = classification_report(y_test, y_pred, output_dict=True, zero_division=0)
        st.dataframe(pd.DataFrame(report).transpose().round(3), use_container_width=True)

        st.markdown("---")

        if hasattr(selected_model, "predict_proba"):
            st.subheader("ROC Curve")
            y_prob = selected_model.predict_proba(X_test)[:, 1]
            plot_roc_curve(y_test, y_prob)

        st.markdown("---")

        fi = get_feature_importance(selected_model, X.columns)
        if fi is not None:
            st.subheader("Feature Importance")
            st.bar_chart(fi.head(15))
        else:
            st.info("This model does not expose feature importance values.")

        st.markdown("---")

        if st.button("Download Trained Model", use_container_width=True):
            model_bytes = pickle.dumps(selected_model)
            st.download_button(
                label="Save model as .pkl",
