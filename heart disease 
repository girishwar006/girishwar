@st.cache_data
def load_dataset(file):
    return pd.read_csv(file)

def validate_dataset(df):
    if df is None:
        raise ValueError("No dataset provided.")
    if "target" not in df.columns:
        raise ValueError("The dataset must contain a 'target' column.")
    if df.empty:
        raise ValueError("The uploaded dataset is empty.")
    if df["target"].isna().any():
        raise ValueError("The target column contains missing values.")
    if set(df["target"].unique()) - {0, 1}:
        raise ValueError("The target column must be binary and encoded as 0 and 1 only.")
    X = df.drop(columns=["target"]).select_dtypes(include=["number"])
    if X.empty:
        raise ValueError("No numeric input features were found. Please provide numeric features only.")
    if df.shape[0] < 25:
        raise ValueError("This demo requires at least 25 records for training and evaluation.")
    if df["target"].value_counts().min() < 5:
        raise ValueError("At least 5 rows per class are required for this demo.")
    return X, df["target"]

def build_models(random_state=42):
    return {
        "Logistic Regression": Pipeline([
            ("imputer", SimpleImputer(strategy="median")),
            ("scaler", StandardScaler()),
            ("model", LogisticRegression(max_iter=2000))
        ]),
        "Decision Tree": Pipeline([
            ("imputer", SimpleImputer(strategy="median")),
            ("model", DecisionTreeClassifier(max_depth=5, random_state=random_state))
        ]),
        "Random Forest": Pipeline([
            ("imputer", SimpleImputer(strategy="median")),
            ("model", RandomForestClassifier(n_estimators=100, random_state=random_state))
        ]),
        "SVM (RBF)": Pipeline([
            ("imputer", SimpleImputer(strategy="median")),
            ("scaler", StandardScaler()),
            ("model", SVC(probability=True, random_state=random_state))
        ]),
    }

def metrics_cards(acc, prec, rec, f1):
    c1, c2, c3, c4 = st.columns(4)
    c1.metric("Accuracy", f"{acc:.3f}")
    c2.metric("Precision", f"{prec:.3f}")
    c3.metric("Recall", f"{rec:.3f}")
    c4.metric("F1-Score", f"{f1:.3f}")

def plot_confusion_matrix(cm):
    fig, ax = plt.subplots(figsize=(5, 4))
    sns.heatmap(
        cm,
        annot=True,
        fmt="d",
        cmap="Blues",
        linewidths=0.5,
        linecolor="white",
        cbar=True,
        xticklabels=["Predicted 0", "Predicted 1"],
        yticklabels=["Actual 0", "Actual 1"],
        ax=ax,
    )
    ax.set_title("Confusion Matrix", fontsize=14, weight="bold")
    ax.set_xlabel("Predicted Label")
    ax.set_ylabel("Actual Label")
    st.pyplot(fig)
    plt.close(fig)

def plot_roc_curve(y_true, y_prob):
    roc_auc = roc_auc_score(y_true, y_prob)
    fpr, tpr, _ = roc_curve(y_true, y_prob)

    fig, ax = plt.subplots(figsize=(6, 4))
    ax.plot(fpr, tpr, color="#2563eb", lw=2, label=f"ROC Curve (AUC = {roc_auc:.3f})")
    ax.plot([0, 1], [0, 1], linestyle="--", color="gray", label="Chance")
    ax.set_xlabel("False Positive Rate")
    ax.set_ylabel("True Positive Rate")
    ax.set_title("ROC Curve")
    ax.legend(loc="lower right")
    st.pyplot(fig)
    plt.close(fig)
    st.metric("ROC-AUC", f"{roc_auc:.3f}")

def get_feature_importance(model, feature_names):
    if model is None:
        return None
    if hasattr(model, "named_steps"):
        estimator = model.named_steps.get("model")
    else:
        estimator = model

    if estimator is None:
        return None

    if hasattr(estimator, "feature_importances_"):
        importance = pd.Series(estimator.feature_importances_, index=feature_names)
        return importance.sort_values(ascending=False)
    return None

